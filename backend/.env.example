# ─── Servidor ────────────────────────────────────────────────
HOST=localhost
PORT=8080
GIN_MODE=debug

# ─── Banco de dados ──────────────────────────────────────────
# Postgres local (docker-compose sobe na porta 6543):
# DATABASE_URL=postgres://postgres:postgres@localhost:6543/metapps?sslmode=disable
# Supabase:
# DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_DRIVER=postgres
DATABASE_URL=
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/metapps_test?sslmode=disable

# ─── Frontend / CORS ─────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ─── Cookies ─────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_DOMAIN_REFRESH=localhost
COOKIE_DOMAIN_OAUTH_STATE=localhost
JWT_TOKEN_COOKIE_PATH=/auth/refresh
OAUTH_STATE_COOKIE_PATH=/auth/google/callback
COOKIE_SECURE=false

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=
ISSUER=metapps-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
EMAIL_VERIFICATION_TTL=1h
OAUTH_STATE_TTL=10m
CLEANUP_INTERVAL=1h

# ─── OAuth Google ────────────────────────────────────────────
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── E-mail (SMTP) ───────────────────────────────────────────
EMAIL_FROM=Metapps <noreply@metapps.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REQUIRE_EMAIL_VERIFICATION=false

# ─── IA ──────────────────────────────────────────────────────
# GEMINI_API_KEY e GEMINI_MODEL sao obrigatorios (o servidor sobe sem a key,
# mas cai no client mock). Prefixo "models/" e opcional.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.6-flash
GROQ_API_KEY=

# ─── Uploads ─────────────────────────────────────────────────
# URL publica usada para montar o link do avatar enviado pelo profile.
# Padrao: http://localhost:$PORT
AVATAR_BASE_URL=http://localhost:8080
