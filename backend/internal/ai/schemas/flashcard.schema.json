{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "FlashcardSet",
    "type": "object",
    "required": [
        "cards"
    ],
    "properties": {
        "cards": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "front",
                    "back"
                ],
                "properties": {
                    "front": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 500
                    },
                    "back": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 2000
                    }
                }
            }
        }
    },
    "additionalProperties": false
}
