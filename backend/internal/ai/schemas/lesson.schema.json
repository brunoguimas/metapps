{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "LessonContent",
    "type": "object",
    "required": [
        "steps"
    ],
    "properties": {
        "version": {
            "type": "integer",
            "minimum": 2
        },
        "steps": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
                "type": "object",
                "required": [
                    "statement",
                    "alternatives",
                    "answer",
                    "explanation"
                ],
                "properties": {
                    "kind": {
                        "type": "string",
                        "enum": [
                            "multiple_choice",
                            "true_false"
                        ]
                    },
                    "statement": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 180
                    },
                    "skill": {
                        "type": "string",
                        "maxLength": 60
                    },
                    "difficulty": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                    },
                    "material": {
                        "type": "array",
                        "maxItems": 3,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "type",
                                "data"
                            ],
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "text",
                                        "image"
                                    ]
                                },
                                "data": {
                                    "type": "string",
                                    "maxLength": 600
                                }
                            }
                        }
                    },
                    "alternatives": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 4,
                        "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                        }
                    },
                    "answer": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                    },
                    "explanation": {
                        "type": "string",
                        "minLength": 5,
                        "maxLength": 400
                    },
                    "hint": {
                        "type": "string",
                        "maxLength": 200
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
