# URL base da API do backend, sem barra no final: o api.js concatena
# os caminhos (ex.: ${VITE_API_URL}/auth/login).
# Sem essa variável o padrão é http://localhost:8080
VITE_API_URL=http://localhost:8080

# Caminho do cookie que guarda o refresh token. Precisa bater com o
# COOKIE_PATH do backend (backend/.env).
VITE_JWT_TOKEN_COOKIE_PATH=/auth/refresh