{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "weight"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_\\-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },

    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },

    "ordering": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parent", "sequence"],
        "properties": {
          "parent": {
            "type": ["string", "null"]
          },
          "sequence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },

  "additionalProperties": false,

  "allOf": [
    {
      "description": "Edges must reference existing node ids",
      "not": {
        "properties": {
          "edges": {
            "contains": {
              "properties": {
                "from": { "not": { "enum": [] } },
                "to": { "not": { "enum": [] } }
              }
            }
          }
        }
      }
    }
  ]
}
